{
  "name": "school-assistant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "pnpm --filter @sa/desktop dev",
    "build": "pnpm --filter @sa/desktop build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && pnpm --filter @sa/desktop e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "fable-kit": "node scripts/make-fable-kit.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.9.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
