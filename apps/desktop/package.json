{
  "name": "@sa/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "School Assistant desktop app (Electron)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "db:generate": "drizzle-kit generate",
    "e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "electron-log": "^5.4.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fullcalendar/react": "^7.1.0",
    "@sa/core": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.50.0",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5",
    "vite": "^7.3.6"
  }
}
